<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>TwinCAT.XAE.BootdataViewer.TcXaeShell64</id>
    <version>$version$</version>
    <title>TwinCAT XAE Bootdata Viewer for TcXaeShell64</title>
    <authors>HA-Freak</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">tools\LICENSE.txt</license>
    <icon>icon.png</icon>
    <description>Integrates the TwinCAT XAE Bootdata Viewer into TwinCAT XAE Shell (64-bit, VS 2022 based): TwinCAT &gt; Bootdata opens the bootdata of the selected PLC from the active target, compares/writes it to the PLC and opens .bootdata files.</description>
    <summary>TwinCAT XAE Bootdata Viewer extension for TcXaeShell64.</summary>
    <tags>TwinCAT XAE Bootdata TCXAESHELL64 UpdateConfigurationOption</tags>
    <dependencies>
      <dependency id="TwinCAT.XAE.Shell64" version="0.0.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="icon.png" target="" />
  </files>
</package>
